page {
  min-height: 100%;
  background: #f4f6f8;
  color: #17212b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #17212b;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.5;
}

.status-chip {
  flex: none;
  padding: 8rpx 14rpx;
  border: 1rpx solid #b7e1d2;
  border-radius: 6rpx;
  background: #eaf8f3;
  color: #0b6b4f;
  font-size: 22rpx;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 650;
  color: #17212b;
}

.section-note {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.card {
  padding: 24rpx;
  border: 1rpx solid #e2e7ec;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(23, 33, 43, 0.04);
  box-sizing: border-box;
}

.card + .card {
  margin-top: 16rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.metric-card {
  min-width: 0;
  padding: 22rpx;
  border: 1rpx solid #e2e7ec;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.metric-label {
  color: #667085;
  font-size: 23rpx;
}

.metric-value {
  margin-top: 10rpx;
  color: #17212b;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
}

.metric-unit {
  margin-left: 4rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 400;
}

.metric-detail {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.4;
}

.list-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.list-row:first-child {
  padding-top: 0;
}

.list-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.list-main {
  min-width: 0;
  flex: 1;
}

.list-title {
  color: #17212b;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 600;
}

.list-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.list-value {
  flex: none;
  color: #0b6b4f;
  font-size: 28rpx;
  font-weight: 700;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 21rpx;
  line-height: 1.2;
}

.tag-high {
  background: #fdecec;
  color: #b42318;
}

.tag-medium {
  background: #fff3d6;
  color: #9a6700;
}

.tag-low {
  background: #eaf8f3;
  color: #0b6b4f;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
  min-height: 80rpx;
  margin: 0;
  border-radius: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.primary-button {
  background: #0b6b4f;
  color: #ffffff;
}

.secondary-button {
  background: #ffffff;
  color: #0b6b4f;
  border: 1rpx solid #b7e1d2;
}

.empty-state {
  padding: 48rpx 24rpx;
  color: #667085;
  text-align: center;
}
