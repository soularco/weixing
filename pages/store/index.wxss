.store-page {
  padding-bottom: 64rpx;
}

.location-actions {
  margin-top: 24rpx;
}

.location-status {
  margin-top: 16rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.map-card {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid #dfe7e4;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(23, 33, 43, 0.04);
}

.store-map {
  display: block;
  width: 100%;
  height: 520rpx;
}

.map-caption {
  padding: 16rpx 20rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.4;
}

.context-summary {
  margin-top: 18rpx;
}

.context-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.context-reason {
  margin-top: 16rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.6;
}

.store-strip {
  width: 100%;
  white-space: nowrap;
}

.store-option {
  display: inline-block;
  width: 280rpx;
  margin-right: 14rpx;
  padding: 20rpx;
  border: 1rpx solid #dfe7e4;
  border-radius: 8rpx;
  background: #ffffff;
  vertical-align: top;
  box-sizing: border-box;
}

.store-option:last-child {
  margin-right: 0;
}

.store-option-active {
  border-color: #0b6b4f;
  background: #eaf8f3;
}

.store-option-name {
  overflow: hidden;
  color: #17212b;
  font-size: 25rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-option-meta {
  margin-top: 8rpx;
  color: #667085;
  font-size: 21rpx;
}

.search-card,
.manual-card {
  margin-top: 16rpx;
}

.search-note {
  margin-top: 16rpx;
  color: #7b8b87;
  font-size: 21rpx;
  line-height: 1.55;
}

.manual-submit {
  margin-top: 22rpx;
}

.nearby-card {
  margin-top: 16rpx;
}

.nearby-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.nearby-row:first-child {
  padding-top: 0;
}

.nearby-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.nearby-main {
  min-width: 0;
  flex: 1;
}

.page-footnote {
  margin: 28rpx 8rpx 0;
  color: #7b8b87;
  font-size: 21rpx;
  line-height: 1.55;
  text-align: center;
}
