.forecast-page {
  padding-bottom: 64rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.card-head-main {
  flex: 1;
  min-width: 0;
}

.card-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.card-title {
  color: #17212b;
  font-size: 30rpx;
  font-weight: 700;
}

.card-note {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

.expand-link {
  flex: none;
  padding-top: 3rpx;
  color: #0b6b4f;
  font-size: 23rpx;
  font-weight: 600;
}

.data-state {
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: #eaf8f3;
  color: #0b6b4f;
  font-size: 21rpx;
}

.card-body {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf0f3;
}

.import-actions {
  margin-top: 0;
}

.import-actions .secondary-button,
.import-submit .secondary-button {
  min-height: 60rpx;
  font-size: 23rpx;
  line-height: 60rpx;
}

.data-editor {
  width: 100%;
  height: 280rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #dfe7e4;
  border-radius: 8rpx;
  background: #fbfdfc;
  box-sizing: border-box;
  color: #263630;
  font-family: Consolas, Monaco, monospace;
  font-size: 22rpx;
  line-height: 1.55;
}

.editor-placeholder {
  color: #9aa7a3;
}

.import-footer {
  margin-top: 16rpx;
}

.import-message {
  min-height: 34rpx;
  color: #7b8b87;
  font-size: 22rpx;
  line-height: 1.5;
}

.import-message-active {
  color: #0b6b4f;
}

.import-submit {
  margin-top: 12rpx;
}

.segmented {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 8rpx;
  border: 1rpx solid #e2e7ec;
  border-radius: 8rpx;
  background: #ffffff;
}

.segment {
  min-height: 64rpx;
  border-radius: 6rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: center;
  white-space: nowrap;
}

.segment-active {
  background: #0b6b4f;
  color: #ffffff;
  font-weight: 600;
}

.empty-state {
  margin-top: 24rpx;
}

.forecast-summary {
  margin-top: 24rpx;
  border-color: #173f38;
  background: #102f2a;
  color: #ffffff;
}

.summary-head {
  position: relative;
}

.summary-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.summary-kicker {
  color: #b7e1d2;
  font-size: 24rpx;
}

.summary-expand {
  color: #b7e1d2;
  font-size: 22rpx;
}

.summary-number {
  margin-top: 10rpx;
  font-size: 64rpx;
  line-height: 1.14;
  font-weight: 750;
}

.summary-detail {
  margin-top: 8rpx;
  color: #d8e9e4;
  font-size: 23rpx;
}

.summary-split {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.summary-split .metric-label {
  color: #b7e1d2;
}

.summary-small {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.explain-card {
  margin-top: 16rpx;
}

.sub-title {
  color: #17212b;
  font-size: 27rpx;
  font-weight: 700;
}

.reason-text {
  margin-top: 14rpx;
  color: #344054;
  font-size: 25rpx;
  line-height: 1.7;
}

.compact-grid {
  margin-top: 18rpx;
}

.quiet-card {
  padding: 18rpx;
  background: #fbfdfc;
}

.metric-note {
  margin-top: 8rpx;
  color: #344054;
  font-size: 22rpx;
  line-height: 1.45;
}

.small-value {
  margin-top: 8rpx;
  font-size: 30rpx;
}

.table-title {
  margin-top: 28rpx;
}

.data-table-wrap {
  width: 100%;
  margin-top: 14rpx;
}

.data-table {
  min-width: 930rpx;
  border: 1rpx solid #e2e7ec;
  border-radius: 8rpx;
  overflow: hidden;
}

.data-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid #edf0f3;
  background: #ffffff;
}

.data-row:last-child {
  border-bottom: 0;
}

.data-head {
  background: #f5faf8;
  color: #48615a;
  font-weight: 650;
}

.data-cell {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  padding: 10rpx 14rpx;
  box-sizing: border-box;
  border-right: 1rpx solid #edf0f3;
  color: #344054;
  font-size: 22rpx;
  white-space: nowrap;
}

.data-cell:last-child {
  border-right: 0;
}

.data-cell:nth-child(1) {
  width: 170rpx;
}

.data-cell:nth-child(2) {
  width: 110rpx;
}

.data-cell:nth-child(3) {
  width: 130rpx;
}

.data-cell:nth-child(4) {
  width: 150rpx;
}

.data-cell:nth-child(5) {
  width: 360rpx;
}

.table-type {
  padding: 5rpx 9rpx;
  border-radius: 5rpx;
  font-size: 20rpx;
}

.table-actual {
  background: #eaf8f3;
  color: #0b6b4f;
}

.table-forecast {
  background: #fff3d6;
  color: #9a6700;
}

.recommendation {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.recommendation:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.recommendation-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.recommendation-title {
  color: #17212b;
  font-size: 25rpx;
  font-weight: 650;
}

.priority {
  padding: 4rpx 10rpx;
  border-radius: 5rpx;
  font-size: 20rpx;
}

.priority-high {
  background: #fdecec;
  color: #b42318;
}

.priority-medium {
  background: #fff3d6;
  color: #9a6700;
}

.recommendation-action {
  margin-top: 10rpx;
  color: #344054;
  font-size: 23rpx;
  line-height: 1.55;
}

.recommendation-reason {
  margin-top: 7rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.chart-legend {
  flex: none;
  color: #667085;
  font-size: 21rpx;
  white-space: nowrap;
}

.legend-dot {
  display: inline-block;
  width: 20rpx;
  height: 6rpx;
  margin: 0 6rpx 3rpx 10rpx;
  border-radius: 3rpx;
}

.legend-dot:first-child {
  margin-left: 0;
}

.actual-dot {
  background: #0b6b4f;
}

.forecast-dot {
  background: #d97706;
}

.chart-card {
  padding-top: 28rpx;
}

.trend-canvas {
  display: block;
  width: 100%;
  height: 430rpx;
  background: #ffffff;
}

.chart-stat-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f3;
}

.chart-stat {
  min-width: 0;
  padding: 12rpx;
  border-radius: 6rpx;
  background: #f5faf8;
  text-align: center;
}

.chart-stat-label {
  color: #667085;
  font-size: 21rpx;
}

.chart-stat-value {
  margin-top: 6rpx;
  color: #0b6b4f;
  font-size: 28rpx;
  font-weight: 700;
}

.distribution-card {
  margin-top: 16rpx;
}

.distribution-layout {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.distribution-canvas {
  display: block;
  flex: none;
  width: 250rpx;
  height: 250rpx;
}

.distribution-legend {
  flex: 1;
  min-width: 0;
}

.legend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.legend-row:last-child {
  border-bottom: 0;
}

.legend-name {
  display: flex;
  align-items: center;
  min-width: 0;
  color: #344054;
  font-size: 23rpx;
}

.legend-color {
  display: inline-block;
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin-right: 10rpx;
  border-radius: 3rpx;
}

.legend-value {
  flex: none;
  color: #17212b;
  font-size: 26rpx;
  font-weight: 700;
}

.bar-card {
  margin-top: 16rpx;
}

.chart-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.mini-chip {
  flex: none;
  padding: 5rpx 10rpx;
  border-radius: 5rpx;
  background: #eaf8f3;
  color: #0b6b4f;
  font-size: 20rpx;
  white-space: nowrap;
}

.bar-chart {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 300rpx;
  margin-top: 24rpx;
}

.bar-column {
  display: flex;
  flex: 1;
  min-width: 0;
  height: 100%;
  flex-direction: column;
  justify-content: flex-end;
}

.bar-value {
  min-height: 32rpx;
  color: #0b6b4f;
  font-size: 18rpx;
  font-weight: 650;
  text-align: center;
  white-space: nowrap;
}

.bar-track {
  position: relative;
  display: flex;
  align-items: flex-end;
  height: 220rpx;
  overflow: hidden;
  border-radius: 6rpx 6rpx 0 0;
  background: #edf7f3;
}

.bar-fill {
  width: 100%;
  min-height: 8rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #16896a;
}

.bar-label {
  margin-top: 10rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}

.driver-board {
  padding-bottom: 20rpx;
}

.driver-preview {
  margin-top: 22rpx;
  padding-top: 6rpx;
}

.driver-preview-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.driver-preview-item:last-child {
  border-bottom: 0;
}

.driver-preview-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.driver-name {
  color: #344054;
  font-size: 24rpx;
  font-weight: 600;
}

.driver-impact {
  color: #0b6b4f;
  font-size: 24rpx;
  font-weight: 700;
}

.strength-track {
  position: relative;
  height: 10rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: #edf2f0;
}

.strength-fill {
  height: 100%;
  border-radius: 5rpx;
}

.strength-high {
  background: #0b6b4f;
}

.strength-medium {
  background: #16896a;
}

.strength-low {
  background: #9ac9b8;
}

.driver-detail {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #edf0f3;
}

.factor {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.factor:last-child {
  border-bottom: 0;
}

.factor-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.factor-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eaf8f3;
  color: #0b6b4f;
  font-size: 21rpx;
  font-weight: 700;
}

.factor-text {
  flex: 1;
  color: #17212b;
  font-size: 25rpx;
  font-weight: 650;
}

.factor-impact {
  flex: none;
  color: #0b6b4f;
  font-size: 24rpx;
  font-weight: 700;
}

.strength-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
}

.strength-row .strength-track {
  flex: 1;
  margin-top: 0;
}

.factor-direction {
  flex: none;
  color: #667085;
  font-size: 21rpx;
}

.factor-reason {
  margin-top: 9rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.55;
}

.board-divider {
  height: 1rpx;
  margin: 26rpx 0;
  background: #edf0f3;
}

.comparison-row {
  display: grid;
  grid-template-columns: 180rpx 1fr 150rpx;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.comparison-name {
  color: #344054;
  font-size: 22rpx;
  white-space: nowrap;
}

.comparison-bar {
  height: 12rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #edf2f0;
}

.comparison-fill {
  height: 100%;
  border-radius: 6rpx;
  background: #16896a;
}

.comparison-value {
  color: #667085;
  font-size: 21rpx;
  text-align: right;
  white-space: nowrap;
}

.recommended-chip {
  grid-column: 1 / -1;
  justify-self: start;
}

.data-quality {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.quality-score {
  flex: none;
  width: 130rpx;
  padding: 16rpx 10rpx;
  border-radius: 8rpx;
  background: #102f2a;
  text-align: center;
}

.quality-value {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 750;
}

.quality-label {
  margin-top: 3rpx;
  color: #b7e1d2;
  font-size: 21rpx;
}

.quality-main {
  flex: 1;
  min-width: 0;
}

.quality-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
}

.model-board {
  padding-bottom: 20rpx;
}

.model-body {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf0f3;
}

.model-mode {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 8rpx;
  background: #f3f7f5;
}

.model-tab {
  min-height: 66rpx;
  border-radius: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 66rpx;
  text-align: center;
}

.model-tab-active {
  background: #0b6b4f;
  color: #ffffff;
  font-weight: 650;
}

.model-panel {
  margin-top: 20rpx;
}

.model-feature {
  position: relative;
  padding: 10rpx 0 10rpx 24rpx;
  color: #344054;
  font-size: 23rpx;
  line-height: 1.55;
}

.model-feature::before {
  position: absolute;
  top: 22rpx;
  left: 2rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #16896a;
  content: "";
}

.field-label {
  margin-top: 18rpx;
  color: #344054;
  font-size: 23rpx;
  font-weight: 600;
}

.model-input {
  height: 76rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dfe7e4;
  border-radius: 8rpx;
  background: #fbfdfc;
  box-sizing: border-box;
  color: #17212b;
  font-size: 23rpx;
}

.model-panel .button-row {
  margin-top: 20rpx;
}

.compact-button {
  min-height: 68rpx;
  font-size: 23rpx;
  line-height: 68rpx;
}

.api-status {
  margin-top: 16rpx;
  color: #0b6b4f;
  font-size: 22rpx;
  line-height: 1.5;
}

.api-error {
  margin-top: 16rpx;
  color: #b42318;
  font-size: 22rpx;
  line-height: 1.5;
}

.custom-analysis {
  margin-top: 16rpx;
  padding: 18rpx;
  border-left: 4rpx solid #16896a;
  border-radius: 0 8rpx 8rpx 0;
  background: #f5faf8;
  color: #344054;
  font-size: 23rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.scenario-panel {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf0f3;
}

.scenario-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.scenario-value {
  flex: none;
  color: #0b6b4f;
  font-size: 32rpx;
  font-weight: 750;
}

.scenario-panel slider {
  margin: 22rpx 0 0;
}

.scenario-scale {
  display: flex;
  justify-content: space-between;
  color: #7b8b87;
  font-size: 20rpx;
}

.page-footnote {
  margin: 28rpx 8rpx 0;
  color: #7b8b87;
  font-size: 21rpx;
  line-height: 1.55;
  text-align: center;
}

.context-card,
.algorithm-card,
.factor-control-card {
  margin-top: 24rpx;
}

.context-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.context-item {
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 6rpx;
  background: #f5faf8;
}

.context-value {
  margin-top: 8rpx;
  color: #0b6b4f;
  font-size: 27rpx;
  font-weight: 700;
}

.context-reason {
  margin-top: 14rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.55;
}

.algorithm-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border-radius: 8rpx;
  background: #f3f7f5;
}

.algorithm-tab {
  min-height: 64rpx;
  border-radius: 6rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 64rpx;
  text-align: center;
}

.algorithm-tab-active {
  background: #0b6b4f;
  color: #ffffff;
  font-weight: 650;
}

.factor-control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.factor-control-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.factor-control-label {
  color: #344054;
  font-size: 24rpx;
}

.factor-picker,
.factor-switch {
  min-width: 140rpx;
  padding: 10rpx 16rpx;
  border: 1rpx solid #dfe7e4;
  border-radius: 6rpx;
  background: #fbfdfc;
  color: #344054;
  font-size: 22rpx;
  text-align: center;
}

.factor-switch-on {
  border-color: #b7e1d2;
  background: #eaf8f3;
  color: #0b6b4f;
}

.first-day-panel {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #dfe7e4;
  border-radius: 8rpx;
  background: #fbfdfc;
}

.first-day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.first-day-number {
  margin-top: 14rpx;
  color: #0b6b4f;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 750;
}

.first-day-meta {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

.draft-chart {
  margin-top: 20rpx;
  border-top: 1rpx solid #dfe7e4;
}

.draft-line {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 130rpx 110rpx;
  align-items: center;
  min-height: 62rpx;
  border-bottom: 1rpx solid #edf0f3;
  color: #344054;
  font-size: 21rpx;
}

.draft-line:last-child {
  border-bottom: 0;
}

.draft-axis {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 1rpx;
  background: #b7e1d2;
}

.draft-label {
  padding-left: 14rpx;
}

.draft-value {
  color: #17212b;
  font-weight: 650;
  text-align: right;
}

.draft-impact {
  color: #0b6b4f;
  text-align: right;
}

.distribution-stats {
  margin-top: 16rpx;
}

.error-card {
  margin-top: 16rpx;
}

.error-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.error-value {
  margin-top: 8rpx;
  color: #0b6b4f;
  font-size: 28rpx;
  font-weight: 700;
}

.error-direction {
  margin-top: 16rpx;
  color: #667085;
  font-size: 22rpx;
}

.error-run {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf0f3;
}

.error-run-main {
  min-width: 0;
  flex: 1;
}

.error-run-title {
  color: #344054;
  font-size: 23rpx;
  font-weight: 600;
}

.error-run-note {
  margin-top: 6rpx;
  color: #667085;
  font-size: 21rpx;
}

@media (max-width: 360px) {
  .distribution-layout {
    align-items: flex-start;
  }

  .distribution-canvas {
    width: 210rpx;
    height: 210rpx;
  }

  .comparison-row {
    grid-template-columns: 156rpx 1fr 136rpx;
  }

  .chart-legend {
    display: none;
  }
}

.forecast-hero {
  position: relative;
  overflow: hidden;
  margin-top: 0;
  border-color: #1a554a;
  background: linear-gradient(145deg, #102f2a 0%, #123b33 58%, #174a3f 100%);
  box-shadow: 0 12rpx 30rpx rgba(11, 107, 79, 0.18);
}

.hero-glow {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #27b98b 0%, #d9a126 55%, #4b72dd 100%);
}

.hero-eyebrow {
  display: inline-block;
  padding: 5rpx 12rpx;
  border: 1rpx solid rgba(183, 225, 210, 0.38);
  border-radius: 5rpx;
  background: rgba(223, 245, 237, 0.12);
  color: #dff5ed;
  font-size: 21rpx;
  font-weight: 650;
}

.forecast-hero .summary-kicker {
  margin-top: 12rpx;
}

.hero-unit {
  color: #b7e1d2;
}

.hero-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.hero-model {
  flex: 1;
  min-width: 0;
  color: #b7e1d2;
  font-size: 20rpx;
  line-height: 1.45;
}

.hero-confidence {
  flex: none;
  width: 190rpx;
  color: #dff5ed;
  font-size: 19rpx;
  text-align: right;
}

.hero-confidence-track {
  height: 8rpx;
  margin-bottom: 7rpx;
  overflow: hidden;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-confidence-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #78dfb9, #dff5ed);
}

.forecast-range {
  margin-top: 24rpx;
}

.import-mode {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 8rpx;
  background: #f3f7f5;
}

.import-mode-tab {
  min-height: 64rpx;
  border-radius: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 64rpx;
  text-align: center;
}

.import-mode-tab-active {
  background: #0b6b4f;
  color: #ffffff;
  font-weight: 650;
}

.source-panel {
  margin-top: 18rpx;
}

.structure-panel {
  padding: 20rpx;
  border: 1rpx solid #cfe9df;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #f5fcf9 0%, #ebf8f3 100%);
}

.structure-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.structure-title {
  color: #173f38;
  font-size: 25rpx;
  font-weight: 700;
}

.structure-status {
  padding: 5rpx 10rpx;
  border-radius: 5rpx;
  background: #ffffff;
  color: #667085;
  font-size: 20rpx;
}

.structure-status-ready {
  background: #0b6b4f;
  color: #ffffff;
}

.field-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.field-chip-row-secondary {
  margin-top: 10rpx;
}

.field-chip {
  padding: 6rpx 10rpx;
  border: 1rpx solid #dfe7e4;
  border-radius: 5rpx;
  background: #ffffff;
  color: #667085;
  font-size: 19rpx;
}

.field-chip-required {
  border-color: #9bd8c3;
  background: #dff5ed;
  color: #0b6b4f;
  font-weight: 650;
}

.structure-foot {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 16rpx;
  color: #55736a;
  font-size: 20rpx;
  line-height: 1.45;
}

.file-drop {
  padding: 28rpx 22rpx;
  border: 1rpx dashed #9bd8c3;
  border-radius: 8rpx;
  background: #f5fcf9;
  text-align: center;
}

.file-drop-title {
  color: #173f38;
  font-size: 28rpx;
  font-weight: 700;
}

.file-drop-note {
  margin-top: 10rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

.file-drop-types {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.file-type-chip {
  padding: 5rpx 12rpx;
  border-radius: 5rpx;
  background: #eaf8f3;
  color: #0b6b4f;
  font-size: 20rpx;
}

.file-button {
  margin-top: 20rpx;
}

.utility-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.utility-row .compact-button {
  flex: 1 1 200rpx;
}

.trend-canvas,
.distribution-canvas {
  touch-action: none;
}

.chart-focus-strip,
.distribution-focus,
.bar-focus {
  margin-top: 14rpx;
  padding: 15rpx 18rpx;
  border: 1rpx solid #e2e7ec;
  border-radius: 6rpx;
  background: #f8fbfa;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.45;
}

.chart-focus-active,
.distribution-focus-active,
.bar-focus-active {
  border-color: #b7e1d2;
  background: #eaf8f3;
}

.focus-title {
  color: #173f38;
  font-size: 23rpx;
  font-weight: 700;
}

.focus-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 22rpx;
  margin-top: 8rpx;
  color: #48615a;
  font-size: 20rpx;
}

.focus-placeholder {
  color: #7b8b87;
  font-size: 21rpx;
}

.distribution-card {
  background: linear-gradient(135deg, #ffffff 0%, #f0faf5 100%);
}

.legend-row-active {
  margin: 0 -10rpx;
  padding-right: 10rpx;
  padding-left: 10rpx;
  border-radius: 6rpx;
  background: rgba(150, 229, 199, 0.28);
}

.distribution-focus {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.distribution-focus-label {
  display: flex;
  align-items: center;
  color: #344054;
  font-size: 22rpx;
  font-weight: 650;
}

.distribution-focus-value {
  color: #0b6b4f;
  font-size: 28rpx;
  font-weight: 750;
}

.jade-card {
  border-color: rgba(155, 216, 195, 0.72);
  background: rgba(183, 235, 215, 0.30);
}

.bar-scroll {
  width: 100%;
}

.bar-chart-shell {
  position: relative;
  padding: 26rpx 0 0 76rpx;
  box-sizing: border-box;
}

.bar-grid {
  position: absolute;
  top: 26rpx;
  right: 0;
  bottom: 96rpx;
  left: 0;
  pointer-events: none;
}

.bar-grid-line {
  position: absolute;
  right: 0;
  left: 0;
  border-top: 1rpx solid #dfeae6;
}

.bar-grid-line text {
  position: absolute;
  top: -13rpx;
  left: 0;
  width: 64rpx;
  color: #7b8b87;
  font-size: 18rpx;
  text-align: right;
}

.bar-grid-line-top { top: 0; }
.bar-grid-line-mid { top: 50%; }
.bar-grid-line-bottom { bottom: 0; }

.bar-chart {
  position: relative;
  z-index: 1;
  align-items: flex-end;
  gap: 16rpx;
  height: 324rpx;
  margin-top: 0;
}

.bar-column {
  padding: 8rpx 4rpx 0;
  border-radius: 8rpx;
  box-sizing: border-box;
  transition: background 0.2s ease, transform 0.2s ease;
}

.bar-column-active {
  background: rgba(150, 229, 199, 0.22);
}

.bar-value {
  min-height: 31rpx;
  overflow: hidden;
  color: #48615a;
  font-size: 18rpx;
  text-overflow: ellipsis;
}

.bar-column-active .bar-value {
  color: #0b6b4f;
  font-weight: 700;
}

.bar-track {
  height: 220rpx;
  overflow: hidden;
  border: 1rpx solid rgba(183, 225, 210, 0.66);
  border-radius: 7rpx;
  background: linear-gradient(180deg, rgba(245, 252, 249, 0.72), rgba(234, 248, 243, 0.88));
}

.bar-fill {
  width: 100%;
  min-height: 8rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: linear-gradient(180deg, #35c093 0%, #0b6b4f 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.28);
}

.bar-column-active .bar-fill {
  background: linear-gradient(180deg, #43d2a4 0%, #087256 100%);
}

.bar-label {
  margin-top: 9rpx;
  color: #344054;
  font-size: 20rpx;
  font-weight: 650;
}

.bar-weekday {
  margin-top: 3rpx;
  color: #98a2b3;
  font-size: 17rpx;
}

.bar-focus {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.bar-focus-main {
  min-width: 0;
  flex: 1;
}

.bar-focus-value {
  flex: none;
  color: #0b6b4f;
  font-size: 34rpx;
  font-weight: 750;
}

.control-section {
  margin-top: 36rpx;
}

.control-card {
  position: relative;
  overflow: hidden;
  transition: transform 0.16s ease, background 0.16s ease;
}

.control-card::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 5rpx;
  content: "";
}

.context-control {
  border-color: #cfe9df;
  background: #fbfefd;
}

.context-control::before {
  background: linear-gradient(90deg, #0b6b4f, #42c99d);
}

.algorithm-control {
  border-color: #d8e2f9;
  background: #fbfcff;
}

.algorithm-control::before {
  background: linear-gradient(90deg, #2f6fed, #7a9cf7);
}

.factor-control {
  border-color: #f0dfb8;
  background: #fffdf8;
}

.factor-control::before {
  background: linear-gradient(90deg, #d97706, #f0bd58);
}

.control-card-active {
  background: #f0faf6;
  transform: scale(0.995);
}

.control-card-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.control-card-copy {
  flex: 1;
  min-width: 0;
}

.control-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 58rpx;
  height: 58rpx;
  border-radius: 8rpx;
  font-size: 25rpx;
  font-weight: 750;
}

.context-badge {
  background: #dff5ed;
  color: #0b6b4f;
}

.algorithm-badge {
  background: #eaf0ff;
  color: #2f6fed;
}

.factor-badge {
  background: #fff3d6;
  color: #9a6700;
}

.context-control .context-grid {
  margin-top: 22rpx;
}

.context-control .context-item {
  border: 1rpx solid #d7eee5;
  background: rgba(183, 235, 215, 0.26);
}

.algorithm-control .algorithm-tabs {
  margin-top: 22rpx;
  background: #edf2fd;
}

.algorithm-control .algorithm-tab-active {
  background: #2f6fed;
}

.factor-control .factor-control-row {
  margin-top: 12rpx;
  padding: 15rpx 14rpx;
  border: 1rpx solid #f0e5cc;
  border-radius: 6rpx;
  background: rgba(255, 243, 214, 0.28);
}

.factor-control .factor-picker,
.factor-control .factor-switch {
  background: #ffffff;
}

.factor-control .factor-switch-on {
  border-color: #e2b45a;
  background: #fff3d6;
  color: #9a6700;
}

.control-empty {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 6rpx;
  background: rgba(183, 235, 215, 0.22);
  color: #55736a;
  font-size: 22rpx;
}

@media (max-width: 360px) {
  .hero-foot,
  .structure-foot {
    display: block;
  }

  .hero-confidence {
    width: 100%;
    margin-top: 12rpx;
    text-align: left;
  }

  .structure-foot text {
    display: block;
    margin-top: 6rpx;
  }

  .bar-chart-shell {
    min-width: 760rpx !important;
  }
}
