.chip-ready {
  border-color: #9bd8c3;
  background: #dff5ed;
}

.coverage-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.coverage-card {
  min-width: 0;
  padding: 20rpx 16rpx;
  border: 1rpx solid #e2e7ec;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.coverage-value {
  margin-top: 8rpx;
  color: #17212b;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  word-break: break-all;
}

.shift-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.shift-row:first-child {
  padding-top: 0;
}

.shift-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.shift-time {
  flex: none;
  width: 140rpx;
  color: #0b6b4f;
  font-size: 23rpx;
  line-height: 1.5;
  font-weight: 650;
}

.shift-main {
  min-width: 0;
  flex: 1;
}

.risk-line {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 0;
}

.risk-line:first-child {
  padding-top: 0;
}

.risk-line:last-child {
  padding-bottom: 0;
}

.risk-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #d97706;
}

.risk-text {
  flex: 1;
  color: #344054;
  font-size: 25rpx;
  line-height: 1.55;
}
