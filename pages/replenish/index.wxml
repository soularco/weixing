<view class="page">
  <view class="page-header">
    <view>
      <view class="page-title">补货建议</view>
      <view class="page-subtitle">结合库存覆盖天数、预测销量和活动影响生成</view>
    </view>
    <view class="status-chip">演示数据</view>
  </view>

  <view wx:if="{{loading}}" class="card empty-state">正在计算库存风险...</view>

  <block wx:else>
    <view class="summary-strip">
      <view>
        <view class="metric-label">待处理商品</view>
        <view class="summary-value">{{pendingCount}} 项</view>
      </view>
      <view>
        <view class="metric-label">建议补货合计</view>
        <view class="summary-value">{{suggestedTotal}} 件</view>
      </view>
    </view>

    <view class="section-title item-section-title">建议清单</view>
    <view class="card" wx:for="{{items}}" wx:key="id">
      <view class="item-header">
        <view class="list-main">
          <view class="list-title {{item.handled ? 'item-handled' : ''}}">{{item.name}}</view>
          <view class="list-desc">现有 {{item.stock}} 件 · 建议补 {{item.suggested}} 件</view>
        </view>
        <view class="tag {{item.urgency === '高' ? 'tag-high' : 'tag-medium'}}">{{item.urgency}}</view>
      </view>
      <view class="reason">{{item.reason}}</view>
      <button
        class="item-button {{item.handled ? 'item-button-done' : ''}}"
        data-id="{{item.id}}"
        bindtap="toggleHandled"
      >{{item.handled ? '已处理，点击撤销' : '标记为已处理'}}</button>
    </view>
  </block>
</view>
